	bitmap xhair;
	x=0; y=10;
	text debug;
	x=-480; y=350;
} solid;

trial { picture default; } default_trial;

trial {

	trial_type = fixed;
	clear_active_stimuli = true;

	picture solid;
	time=0;
	
} solid_trial;

