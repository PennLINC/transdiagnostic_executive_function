	trial_type = fixed;
	clear_active_stimuli = true;

	picture {
		default_code="pic1";
		bitmap xhair;
		x=0; y=10;
		text debug;
		x=-480; y=350;
	} pic1;
	time=0;
	#duration = 800; ## removed because causing flicker between crosshair slides ##

} trial1;


